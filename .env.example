# Copy to .env and fill in your values. .env is gitignored.

# Weights & Biases API key. Get it from https://wandb.ai/authorize
# Used by the WandbLogger in train.py.
WANDB_API_KEY=

# Optional: override the W&B project names baked into train.py.
# Defaults: CNN-CIFAR10 / ViT-CIFAR10
# WANDB_PROJECT_CNN=CNN-CIFAR10
# WANDB_PROJECT_VIT=ViT-CIFAR10

# Optional: run W&B fully offline (no network calls).
# WANDB_MODE=offline
